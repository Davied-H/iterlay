{
  "name": "iterlay",
  "version": "0.1.68",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "native:build": "bash scripts/build-photo-layer-segmenter.sh",
    "preelectron:dev": "pnpm plugins:build && pnpm native:build",
    "dev": "node scripts/dev-browser.mjs",
    "dev:web": "node scripts/dev-browser.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "electron:dev": "pnpm clean:electron && tsc -p electron/tsconfig.json && pnpm preload:build && concurrently -k -n vite,tsc,preload,electron -c cyan,yellow,magenta,green \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"node scripts/build-preload.mjs --watch\" \"wait-on http-get://127.0.0.1:5180 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5180 nodemon --watch dist-electron --ext js,cjs --delay 800ms --exec 'electron .'\"",
    "prebuild": "pnpm native:build",
    "build": "pnpm build:renderer && pnpm build:electron && pnpm build:cli",
    "test": "vitest run",
    "test:cli:background": "node scripts/cli-background-smoke.mjs",
    "test:canvas:sandbox": "node scripts/build-code-sandbox.mjs && node scripts/playwright-code-canvas-sandbox.mjs",
    "test:browser:smoke": "node scripts/playwright-browser-smoke.mjs",
    "test:browser:assistant": "node scripts/playwright-browser-refactor-assistant.mjs",
    "test:browser:restart": "node scripts/playwright-browser-restart.mjs",
    "test:electron:smoke": "pnpm build:electron && ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-smoke.mjs",
    "pretest:electron:photo-layers": "pnpm build",
    "test:electron:photo-layers": "ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-photo-layers.mjs",
    "test:electron:generate-photo-fixtures": "ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-generate-photo-fixtures.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "electron-builder --dir && node scripts/verify-package-size.mjs",
    "release": "bash scripts/release.sh",
    "media-tools:build": "node scripts/prepare-ffmpeg.mjs",
    "media-tools:verify": "node scripts/verify-packaged-ffmpeg.mjs",
    "package:verify": "node scripts/verify-package-size.mjs",
    "build:renderer": "pnpm plugins:build && tsc -p tsconfig.json && vite build",
    "build:electron": "pnpm clean:electron && tsc -p electron/tsconfig.json && pnpm preload:build",
    "preload:build": "node scripts/build-preload.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p cli/tsconfig.json --noEmit && tsc -p website/tsconfig.json --noEmit",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test && npm test --prefix website && pnpm build:renderer && pnpm build:electron && pnpm build:cli && pnpm build:website",
    "build:cli": "npm run build --prefix cli",
    "build:website": "npm run build --prefix website",
    "bench:storage": "node --expose-gc scripts/benchmark-storage.mjs",
    "setup:subprojects": "npm ci --prefix cli && npm ci --prefix website",
    "plugins:build": "pnpm exec tsc -p packages/plugin-sdk/tsconfig.json && node scripts/build-plugins.mjs && node scripts/build-code-sandbox.mjs",
    "predev": "pnpm plugins:build",
    "predev:web": "pnpm plugins:build",
    "test:browser:plugins": "node scripts/playwright-browser-plugins.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "^8.0.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.39.4",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@remotion/player": "4.0.491",
    "@types/adm-zip": "^0.5.8",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vue/compiler-sfc": "^3.5.44",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.7.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "12.42.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "libavoid-js": "0.5.0-beta.5",
    "lucide-react": "^0.468.0",
    "nodemon": "^3.1.14",
    "ogl": "^1.0.11",
    "playwright": "1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.7.0",
    "remotion": "4.0.491",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^6.4.1",
    "vitest": "^2.1.9",
    "vue": "^3.5.44",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.dong.iterlay",
    "productName": "Iterlay",
    "protocols": [
      {
        "name": "Iterlay Link",
        "schemes": [
          "iterlay"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/electron/dev-browser-*.js",
      "!dist-electron/shared/dev-browser-wire.js",
      "!dist-electron/shared/dev-asset-url.js",
      "!**/.v8-cache{,/**}",
      "!**/*.js.map",
      "!**/*.mjs.map",
      "!**/*.cjs.map"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "demo-assets",
        "to": "demo-assets"
      },
      {
        "from": "resources/app-icons",
        "to": "app-icons"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "photo-layer-segmenter-*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "dist/main.js",
          "guard/**",
          "package.json",
          "skills/**"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "notarize": false
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ]
    },
    "dmg": {
      "format": "UDZO"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.12.3+sha512.467df2c586056165580ad6dfb54ceaad94c5a30f80893ebdec5a44c5aa73c205ae4a5bb9d5ed6bb84ea7c249ece786642bbb49d06a307df218d03da41c317417",
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mastergo/vibe-mcp": "1.0.26",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "^0.6.0",
    "ag-psd": "^28.5.1",
    "fflate": "^0.8.3",
    "node-html-parser": "7.1.0",
    "thumbhash": "^0.1.1",
    "typebox": "1.1.24"
  },
  "license": "MIT"
}
