{
  "name": "iterlay",
  "version": "0.1.57",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "native:build": "bash scripts/build-photo-layer-segmenter.sh",
    "preelectron:dev": "pnpm native:build",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "electron:dev": "pnpm clean:electron && tsc -p electron/tsconfig.json && concurrently -k -n vite,tsc,electron -c cyan,yellow,green \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on http-get://127.0.0.1:5180 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5180 nodemon --watch dist-electron --ext js --delay 800ms --exec 'electron .'\"",
    "prebuild": "pnpm native:build",
    "build": "tsc -p tsconfig.json && vite build && pnpm clean:electron && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:electron:smoke": "ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-smoke.mjs",
    "pretest:electron:photo-layers": "pnpm build",
    "test:electron:photo-layers": "ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-photo-layers.mjs",
    "test:electron:generate-photo-fixtures": "ITERLAY_E2E_ELECTRON=\"$(bash scripts/prepare-playwright-electron.sh)\" node scripts/playwright-electron-generate-photo-fixtures.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "electron-builder --dir && node scripts/verify-packaged-ffmpeg.mjs",
    "release": "bash scripts/release.sh",
    "prepackage": "node scripts/prepare-ffmpeg.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/player": "4.0.491",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.7.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "nodemon": "^3.1.14",
    "ogl": "^1.0.11",
    "playwright": "1.62.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "4.0.491",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.dong.iterlay",
    "productName": "Iterlay",
    "protocols": [
      {
        "name": "Iterlay Link",
        "schemes": [
          "iterlay"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/.v8-cache{,/**}"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "demo-assets",
        "to": "demo-assets"
      },
      {
        "from": "resources/app-icons",
        "to": "app-icons"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "photo-layer-segmenter-*"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "notarize": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.12.3+sha512.467df2c586056165580ad6dfb54ceaad94c5a30f80893ebdec5a44c5aa73c205ae4a5bb9d5ed6bb84ea7c249ece786642bbb49d06a307df218d03da41c317417",
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mastergo/vibe-mcp": "1.0.26",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "^0.6.0",
    "ag-psd": "^28.5.1",
    "ai": "^7.0.47",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "libavoid-js": "0.5.0-beta.5",
    "node-html-parser": "7.1.0",
    "qrcode": "^1.5.4",
    "react-icons": "^5.7.0",
    "thumbhash": "^0.1.1",
    "typebox": "1.1.24",
    "use-stick-to-bottom": "^1.1.6"
  },
  "license": "MIT"
}
