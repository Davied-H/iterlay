{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../shared/mcp-integration.ts",
    "../electron/mcp-integration.ts"
  ]
}
