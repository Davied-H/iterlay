{
  "name": "iterlay",
  "version": "0.1.70",
  "description": "CLI for Iterlay: images, videos, and creative workflows on one canvas. Generate, edit, organize, and export with your configured models.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "iterlay": "dist/main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/**",
    "guard/**",
    "skills/**",
    "README.md",
    "docs/**"
  ],
  "scripts": {
    "build": "node scripts/sync-skill.mjs && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && node scripts/sync-skill.mjs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-html-parser": "^7.1.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5"
  }
}
